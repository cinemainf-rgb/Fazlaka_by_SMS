<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fazlaka" android:textSize="32sp" android:textStyle="bold" />
    <Button android:id="@+id/btnServices" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الخدمات - محافظ وشحن" android:layout_marginTop="24dp" />
    <Button android:id="@+id/btnStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المخزون" android:layout_marginTop="12dp" />
    <Button android:id="@+id/btnReports" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="التقارير" android:layout_marginTop="12dp" />
    <Button android:id="@+id/btnMore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المزيد" android:layout_marginTop="12dp" />
</LinearLayout>
