<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المزيد" android:textSize="28sp" android:textStyle="bold" />
<EditText android:id="@+id/editNewPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PIN جديد 4 ارقام" android:inputType="numberPassword" android:layout_marginTop="16dp" />
<Button android:id="@+id/btnChangePin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تغيير PIN" android:layout_marginTop="12dp" />
<Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="رجوع" android:layout_marginTop="16dp" />
</LinearLayout>
