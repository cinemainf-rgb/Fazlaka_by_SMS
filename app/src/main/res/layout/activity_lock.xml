<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fazlaka" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○" android:textSize="28sp" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/msg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/key1" android:layout_width="70dp" android:layout_height="70dp" android:text="1" />
        <Button android:id="@+id/key2" android:layout_width="70dp" android:layout_height="70dp" android:text="2" />
        <Button android:id="@+id/key3" android:layout_width="70dp" android:layout_height="70dp" android:text="3" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/key4" android:layout_width="70dp" android:layout_height="70dp" android:text="4" />
        <Button android:id="@+id/key5" android:layout_width="70dp" android:layout_height="70dp" android:text="5" />
        <Button android:id="@+id/key6" android:layout_width="70dp" android:layout_height="70dp" android:text="6" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/key7" android:layout_width="70dp" android:layout_height="70dp" android:text="7" />
        <Button android:id="@+id/key8" android:layout_width="70dp" android:layout_height="70dp" android:text="8" />
        <Button android:id="@+id/key9" android:layout_width="70dp" android:layout_height="70dp" android:text="9" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/keyClear" android:layout_width="70dp" android:layout_height="70dp" android:text="C" />
        <Button android:id="@+id/key0" android:layout_width="70dp" android:layout_height="70dp" android:text="0" />
        <Button android:id="@+id/keyBack" android:layout_width="70dp" android:layout_height="70dp" android:text="⌫" />
    </LinearLayout>
    <Button android:id="@+id/btnFinger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="البصمة" android:layout_marginTop="16dp" />
</LinearLayout>
